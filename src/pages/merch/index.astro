---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import { LINKS } from '../../consts';
---

<BaseLayout
  title="Merch"
  description="Tocqueville Liberty Institute tees, hoodies, and sweatshirts. Wear the mission."
>
  <div class="wrap page">
    <header class="head">
      <h1>Merch</h1>
      <p class="lede">
        Tees, hoodies, and sweatshirts for people who would rather argue about
        sound money than the weather.
      </p>
    </header>

    <ul class="grid" role="list">
      {
        PRODUCTS.map((product) => (
          <li>
            <ProductCard product={product} />
          </li>
        ))
      }
    </ul>

    <footer class="foot">
      <a class="btn" href={LINKS.merch} rel="noopener">
        View the full store<span aria-hidden="true"> →</span>
      </a>
      <p class="note">
        Sizes, colors, and checkout are handled on our Printful storefront.
        Prices shown are the lowest variant and were last checked on{' '}
        <time datetime="2026-08-11">August 11, 2026</time>.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .head {
    max-width: var(--measure);
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .lede {
    color: var(--ink-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
    margin: 0;
    padding: 0;
    /* role="list" keeps this a list for screen readers; the markers still need
       removing explicitly. */
    list-style: none;
  }

  .foot {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .note {
    max-width: var(--measure);
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  /* Two-up rather than one-up on small phones — product grids read better
     dense, and these mockups stay legible at this size. */
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
