---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LINKS } from '../../consts';

const entry = await getEntry('pages', 'merch');
if (!entry) throw new Error('Missing src/content/pages/merch.md');
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description="Tocqueville Liberty Institute tees and hoodies. Wear the mission."
>
  <div class="wrap page">
    <h1>Merch</h1>
    <div class="prose">
      <Content />
      <p>
        <a class="btn" href={LINKS.merch} rel="noopener">Visit the store</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  h1 {
    max-width: var(--measure);
  }
</style>
