---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Subscribe from '../components/Subscribe.astro';
import founder from '../assets/site/founder-colonel-pete.jpg';
import emblem from '../assets/site/tli-emblem.png';
import { CONTACT, LINKS, SITE } from '../consts';
import { getSubstackPosts } from '../lib/substack';
import { truncate } from '../lib/text';

// Substack is where new writing goes; the migrated archive lives here. Merge
// both and let recency decide, so the newest piece from either source leads
// and this site's own essays never drop off the homepage entirely.
const substack = await getSubstackPosts(3);

const archive = await getCollection('blog');

const latest = [
  ...substack.map((p) => ({
    href: p.link,
    title: p.title,
    description: truncate(p.description, 160),
    date: p.pubDate,
    external: true,
  })),
  ...archive.map((p) => ({
    href: p.data.permalink,
    title: p.data.title,
    description: truncate(p.data.description, 160),
    date: p.data.pubDate,
    external: false,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

---

<BaseLayout>
  <section class="hero wrap">
    <h1>Civic Education for a Stronger American Republic</h1>
    <p class="lede">{SITE.description}</p>
    <div class="hero__actions">
      <a class="btn" href={LINKS.donate}>Support the mission</a>
      <a class="btn btn--ghost" href="/blog/">Read the essays</a>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head">
        <h2>Latest essays</h2>
        <a href="/blog/">All essays<span aria-hidden="true"> →</span></a>
      </div>
      <ul class="cards">
        {
          latest.map((p) => (
            <li>
              <PostCard {...p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap">
    <a class="feature-roots" href="/roots/">
      <div>
        <p class="feature-roots__kicker">An interactive map</p>
        <h2 class="feature-roots__title">Roots of the Constitution</h2>
        <p class="feature-roots__sub">
          Magna Carta, Locke, Montesquieu, the state constitutions, the Federalist, and its
          critics. See how each one connects to the Constitution, with every quote linked to
          its source.
        </p>
        <span class="feature-roots__cta">Explore the map<span aria-hidden="true"> &rarr;</span></span>
      </div>
      <svg class="feature-roots__mark" viewBox="0 0 110 110" aria-hidden="true">
        <g fill="none" stroke="#6a7286" stroke-width="1.2" stroke-linecap="round">
          <path d="M22 20 L46 48" />
          <path d="M14 58 L40 56" />
          <path d="M24 94 L46 64" />
          <path d="M88 20 L64 48" stroke-dasharray="0.1 4.5" stroke-width="1.8" />
          <path d="M96 58 L70 56" stroke-dasharray="0.1 4.5" stroke-width="1.8" />
          <path d="M86 94 L64 64" stroke-dasharray="5 4" stroke-linecap="butt" />
        </g>
        <circle cx="22" cy="20" r="6" fill="#a67c14" />
        <circle cx="14" cy="58" r="6" fill="#a67c14" />
        <circle cx="24" cy="94" r="6" fill="#2a5a9c" />
        <circle cx="88" cy="20" r="6" fill="#8a2fd0" />
        <circle cx="96" cy="58" r="6" fill="#8a2fd0" />
        <circle cx="86" cy="94" r="6" fill="#a3322b" />
        <ellipse cx="55" cy="56" rx="19" ry="12" fill="#232d3f" />
        <ellipse cx="55" cy="56" rx="15.5" ry="8.5" fill="none" stroke="#c9a24a" stroke-width="1" />
      </svg>
    </a>
  </section>

  <section class="wrap">
    <a class="feature-xinyi" href="/the-house-on-xinyi-road/">
      <div>
        <p class="feature-xinyi__kicker">A history of record</p>
        <h2 class="feature-xinyi__title">The House on Xinyi Road</h2>
        <p class="feature-xinyi__sub">
          Thirty eight years of martial law in Taiwan, and the family who paid for a piece of
          the last stretch of it. The murders of 28 February 1980 are still unsolved.
        </p>
        <span class="feature-xinyi__cta">Read the essay<span aria-hidden="true"> &rarr;</span></span>
      </div>
      <div class="feature-xinyi__seal" aria-hidden="true">
        <span>二二八</span>
      </div>
    </a>
  </section>

  <section class="wrap">
    <a class="feature" href="/six-days-notice/">
      <p class="feature__kicker">A storybook of record</p>
      <h2 class="feature__title">Six Days&rsquo; Notice</h2>
      <p class="feature__sub">
        The Japanese Americans of Bainbridge Island, the war that took them, and
        the neighbors who kept their farms. Free to read, free to download.
      </p>
      <span class="feature__cta">Read the book<span aria-hidden="true"> &rarr;</span></span>
    </a>
  </section>

  <section class="section">
    <div class="wrap founder">
      <figure class="founder__portrait">
        <Image
          src={founder}
          alt="Colonel Pete, founder of the Tocqueville Liberty Institute, in U.S. Air Force dress uniform beside an American flag"
          widths={[400, 600, 800]}
          sizes="(max-width: 780px) 100vw, 380px"
          loading="eager"
        />
      </figure>

      <div class="founder__text">
        <h2>Welcome from the founder</h2>
        <p>
          Welcome to the TLI. Here we are dedicated to learning and inspiring our fellow
          Americans to take action in preserving our republic. Together we can uphold the
          principles of democracy and ensure a brighter future for generations to come.
        </p>
        <p>
          Book an engagement to hear the founding story firsthand — how a Taiwanese immigrant
          came to America, fell in love with this country's founding principles, and now wants
          to reignite that romance for his fellow Americans.
        </p>
        <p>
          <a class="btn btn--ghost" href={CONTACT.phoneHref}>
            Book an engagement — {CONTACT.phone}
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap mission">
      <div class="mission__text">
        <h2>Mission</h2>
        <p>
          We work through workshops, talks, community engagement, and multimedia
          outreach, toward an America where citizens understand the republic well
          enough to keep it. Three commitments run through all of it: civic
          education, active citizenship, and critical thinking.
        </p>
        <p class="mission__more">
          <a href="/about/">Mission, vision, and values in full<span aria-hidden="true"> &rarr;</span></a>
        </p>
      </div>

      <figure class="mission__art">
        <Image
          src={emblem}
          alt="Tocqueville Liberty Institute emblem: an illustrated Statue of Liberty raising a torch, framed by a laurel wreath"
          widths={[400, 800]}
          sizes="(max-width: 900px) 80vw, 400px"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  {
    LINKS.substack && (
      <section class="wrap subscribe-band">
        <Subscribe />
      </section>
    )
  }
</BaseLayout>

<style>
  /* Feature band for the Roots of the Constitution map. Parchment and ink,
     the same dress the map itself wears. */
  .feature-roots {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    background: #fcfaf4;
    border: 1px solid #e6dfcd;
    border-radius: var(--radius);
    padding: clamp(1.75rem, 5vw, 2.75rem);
    margin-block-start: clamp(3rem, 7vw, 4.5rem);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }

  @media (min-width: 641px) {
    .feature-roots {
      grid-template-columns: 1fr auto;
    }
  }

  .feature-roots:hover,
  .feature-roots:focus-visible {
    border-color: #c9a24a;
  }

  .feature-roots__kicker {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--purple-dark);
  }

  .feature-roots__title {
    margin: 0;
  }

  .feature-roots__sub {
    max-width: 52ch;
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
  }

  .feature-roots__cta {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--purple);
  }

  .feature-roots:hover .feature-roots__cta,
  .feature-roots:focus-visible .feature-roots__cta {
    text-decoration: underline;
  }

  .feature-roots__mark {
    width: 110px;
    height: 110px;
  }

  /* Feature band for The House on Xinyi Road. Native dress, echoing the
     二二八 seal card on the page itself. */
  .feature-xinyi {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    background: var(--purple-tint);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: clamp(1.75rem, 5vw, 2.75rem);
    margin-block-start: clamp(3rem, 7vw, 4.5rem);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }

  @media (min-width: 641px) {
    .feature-xinyi {
      grid-template-columns: 1fr auto;
    }
  }

  .feature-xinyi:hover,
  .feature-xinyi:focus-visible {
    border-color: var(--purple);
  }

  .feature-xinyi__kicker {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--purple-dark);
  }

  .feature-xinyi__title {
    margin: 0;
  }

  .feature-xinyi__sub {
    max-width: 52ch;
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
  }

  .feature-xinyi__cta {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--purple);
  }

  .feature-xinyi:hover .feature-xinyi__cta,
  .feature-xinyi:focus-visible .feature-xinyi__cta {
    text-decoration: underline;
  }

  .feature-xinyi__seal {
    width: 110px;
    height: 110px;
    display: grid;
    place-items: center;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .feature-xinyi__seal span {
    writing-mode: vertical-rl;
    font-size: 1.8rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--purple-dark);
  }

  @media (min-width: 641px) {
    .feature-xinyi__seal {
      justify-self: center;
    }
  }

  /* Feature band for the Six Days' Notice storybook. Carries the book's own
     dark palette so it reads as a distinct object, not another essay card. */
  .feature {
    display: block;
    background: #241f19;
    color: #f2ebda;
    text-align: center;
    padding: clamp(2.5rem, 7vw, 4rem) 1.5rem;
    margin-block: clamp(3rem, 7vw, 4.5rem);
    text-decoration: none;
    border: 1px solid #a98f63;
    outline: 0.6px solid #4a4136;
    outline-offset: 7px;
    transition: background 0.18s ease;
  }

  .feature:hover,
  .feature:focus-visible {
    background: #2e2820;
  }

  .feature__kicker {
    color: #b9ad97;
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .feature__title {
    font-family: Iowan Old Style, Palatino, Georgia, Times New Roman, serif;
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f2ebda;
    margin: 0;
  }

  .feature__sub {
    max-width: 34rem;
    margin: 1.2rem auto 0;
    color: #d8cdb6;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .feature__cta {
    display: inline-block;
    margin-top: 1.6rem;
    color: #a98f63;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }

  .lede {
    max-width: 62ch;
    margin-inline: auto;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--ink-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .founder,
  .mission {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 781px) {
    .founder {
      grid-template-columns: minmax(0, 380px) 1fr;
    }
    .mission {
      grid-template-columns: 1fr minmax(0, 400px);
    }
  }

  figure {
    margin: 0;
  }

  .founder__portrait img {
    width: 100%;
    border-radius: var(--radius);
    /* The source photo is a tight head-and-shoulders crop; bias to the top so
       the face is never cut off at narrow widths. */
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .mission__art img {
    width: 100%;
    border-radius: var(--radius);
  }

  .values {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .values li {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .values h3 {
    color: var(--purple);
    font-size: 1.1rem;
  }

  .values p {
    margin: 0;
    color: var(--ink-muted);
  }

  /* Matches the "All essays" link treatment in .section-head. */
  .mission__more {
    margin-bottom: 0;
  }

  .mission__more a {
    font-weight: 600;
    text-decoration: none;
  }
  .mission__more a:hover {
    text-decoration: underline;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-head a {
    font-weight: 600;
    text-decoration: none;
  }
  .section-head a:hover {
    text-decoration: underline;
  }

  .cards {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .subscribe-band {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
</style>
