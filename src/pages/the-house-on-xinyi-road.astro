import Subscribe from '../components/Subscribe.astro';
/**
 * Images are from Wikimedia Commons; licences were verified on the file pages:
 * - monopoly-bureau-1947: File:228 Incident h.jpg (PD-Taiwan-1996, PD in the US)
 * - formosa-magazine-no1: File:美麗島雜誌第一期 Formosa - The Magazine of TAIWAN's
 *   Democratic Movement (No. 1).jpg (CC BY 2.0, Christopher Adams)
 * - first-court-jingmei: File:第一法庭04.jpg (CC BY-SA 4.0, 吳蕙宇)
 * - gikong-church-2011: File:Gikong Presbyterian Church main entrance 20110228.jpg
 *   (CC BY 2.0, MiNe)
 * - lin-yi-hsiung-2014: File:20140422 落實民主 停建核四 林義雄禁食行動 IMG 0173
 *   (13972407175) (cropped).jpg (CC BY-SA 2.0, 李忠衛)
 */
import monopolyBureau1947 from '../assets/xinyi-road/monopoly-bureau-1947.jpg';
import formosaMagazine from '../assets/xinyi-road/formosa-magazine-no1.jpg';
import firstCourt from '../assets/xinyi-road/first-court-jingmei.jpg';
import gikongChurch from '../assets/xinyi-road/gikong-church-2011.jpg';
import linYiHsiung from '../assets/xinyi-road/lin-yi-hsiung-2014.jpg';

const title = 'The House on Xinyi Road';
const description =
  "Taiwan's thirty eight years of martial law, and the family who paid for the last stretch of it: the Lin family murders of 28 February 1980, still unsolved.";
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={new Date('2026-08-28')}
>
  <article class="post">
    <div class="wrap">
      <header class="head">
        <div>
          <p class="kicker">Taipei · Xinyi Road, Section 3, Lane 31, No. 16</p>
          <h1>The House on Xinyi Road</h1>
          <p class="lede">
            Thirty eight years of martial law. One family paid for a piece of the last stretch, in
            a basement, at noon, on the anniversary of the massacre the island was forbidden to
            name.
          </p>
          <p class="pub-note">
            Published as civic education: the record of a country that lived thirty eight years
            without the republic's guardrails, and of the people who built them.
          </p>
        </div>
        <aside class="seal-block">
          <div class="seal" role="img" aria-label="A seal reading two two eight">
            <span>二二八</span>
          </div>
          <p class="seal-cap">The date that keeps coming back</p>
        </aside>
      </header>

      <section class="sec">
        <div class="prose">
          <p class="kicker">One · Two Februaries</p>
          <h2>A widow, a tray of cigarettes, a gun barrel</h2>
          <p class="lede">
            On 27 February 1947 a widow named Lin Chiang-mai <span class="hz">林江邁</span> was
            selling untaxed cigarettes outside the Tianma Tea House <span class="hz">天馬茶房</span> in Taipei.
          </p>
          <p>
            Monopoly Bureau agents took her cash and her goods. She grabbed at one of them. An
            investigator named Yeh Te-ken <span class="hz">葉得根</span> opened her scalp with his
            gun. As the agents ran from the crowd, one fired and hit a bystander, who died the next
            day.
          </p>
          <p>
            The next day the crowd marched. Guards at the Executive Office fired into it. By 8
            March the 21st Division had landed from the mainland, and the village-clearing sweeps <span class="hz">清鄉</span> ran until mid-May. The government's own 1992 commission put
            the dead at eighteen to twenty eight thousand. That number is still fought over in both
            directions.
          </p>
          <p>
            What is not fought over is who died. Judges, doctors, professors, newspapermen,
            provincial assemblymen. The painter Chen Cheng-po <span class="hz">陳澄波</span> was
            shot in front of Chiayi railway station on 25 March and left lying there for three
            days. The Japanese-educated Taiwanese who knew how to run an island were removed from
            it.
          </p>
          <p>Thirty three years later, to the day, a man let himself into a house on Xinyi Road.</p>
        </div>
        <figure class="fig">
          <Image
            src={monopolyBureau1947}
            alt="A dense crowd filling the street outside the three-storey Monopoly Bureau building in Taipei, white smoke rising among them"
            widths={[480, 800, 1080]}
            sizes="(min-width: 62rem) 896px, 100vw"
            loading="lazy"
          />
          <figcaption>
            The crowd outside the Monopoly Bureau's Taipei branch on 28 February 1947, smoke
            rising from the bureau's confiscated goods.
            <span class="fig-credit"
              >Photographer unknown, 1947. Public domain, via Wikimedia Commons.</span
            >
          </figcaption>
        </figure>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Two · The apparatus</p>
          <h2>What was actually standing over them</h2>
          <p>
            Chen Cheng <span class="hz">陳誠</span> declared martial law over Taiwan and Penghu on
            19 May 1949. Chiang Ching-kuo <span class="hz">蔣經國</span> signed it away on 14 July
            1987, effective the next day. Thirty eight years and fifty six days.
          </p>
          <p>
            Under it sat the Temporary Provisions Effective During the Period of National
            Mobilization for Suppression of the Communist Rebellion <span class="hz">動員戡亂時期臨時條款</span>, adopted in May 1948. They granted
            emergency powers with no end date, and were amended in 1960 to lift the two-term limit
            off the president so Chiang Kai-shek <span class="hz">蔣介石</span> could stand again.
            Civilians went before military tribunals. New parties were illegal. New newspaper
            licences were frozen, and the papers that existed were capped at six pages, raised over
            the decades to twelve.
          </p>
          <p>
            A parliament elected on the mainland in 1947 and 1948 sat for forty three years.
            Supplementary seats were opened to island voters from 1969, but the mainland members
            themselves never faced an electorate again. People called it the ten thousand year
            parliament <span class="hz">萬年國會</span>. Nobody meant it kindly.
          </p>
        </div>
        <div class="plate">
          <div class="stats">
            <div class="stat">
              <b class="num">38</b>
              <small
                >Years of martial law, plus fifty six days. In force 20 May 1949 to 15 July
                1987</small
              >
            </div>
            <div class="stat">
              <b class="num">29,407</b>
              <small
                >Military court political cases against non-active-duty personnel, 1949 to 1987.
                Ministry of Justice report to the legislature, late 1980s</small
              >
            </div>
            <div class="stat">
              <b class="num">4,101</b>
              <small
                >Decisions Chiang Kai-shek personally made in military court cases, the most of any
                individual in the Transitional Justice Database</small
              >
            </div>
            <div class="stat">
              <b class="num">17,941</b>
              <small>Names on the official victim list after the 2023 revision, up from 8,088</small
              >
            </div>
          </div>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Three · Yilan</p>
          <h2>A lawyer from Wujie</h2>
          <p>
            Lin Yi-hsiung <span class="hz">林義雄</span> was born on 24 August 1941 in Wujie
            Township <span class="hz">五結鄉</span>, Yilan County <span class="hz">宜蘭縣</span>,
            when the island was still Japanese. His father died when he was ten. He took his law
            degree at National Taiwan University in 1964 and passed the bar in 1966, placing first
            in the country.
          </p>
          <p>
            He defended Kuo Yu-hsin <span class="hz">郭雨新</span> after the KMT <span class="hz">國民黨</span> took Yilan's legislative seat from him by fraud, and
            co-wrote the books documenting how it was done. In 1973 he helped found a legal
            services centre for ordinary people in Taipei. In 1977 Yilan sent him to the Provincial
            Assembly with more than seventy three thousand votes, the highest count in the county.
          </p>
          <p>Then he took a job as circulation manager of a magazine.</p>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Four · Kaohsiung, 10 December 1979</p>
          <h2>The trial they made the mistake of holding in public</h2>
          <p>
            <em>Formosa</em> <span class="hz">美麗島</span> launched on 16 August 1979 and sold out
            its first issue. By autumn it was moving upwards of a hundred thousand copies an issue,
            and its service offices around the island were functioning as a political party that
            could not legally exist.
          </p>
          <p>
            On Human Rights Day, 10 December 1979, <em>Formosa</em> held an unauthorised rally in
            Kaohsiung <span class="hz">高雄</span>. Police occupied the venue, so the crowd moved
            to a traffic circle. Tear gas went in around eight in the evening. The Garrison Command <span class="hz">警備總司令部</span> afterwards reported 183 police injured and one
            civilian. Nobody believed it.
          </p>
          <p>
            Arrests began on the 13th. Lin was taken that day, interrogated for forty two days, and
            tortured. The military court excluded the tape recordings that supported him and
            admitted the confession that did not. Eight defendants: life for Shih Ming-teh <span class="hz">施明德</span>, fourteen years for Huang Hsin-chieh <span class="hz">黃信介</span>, twelve years each for the other six. Lin was one of the
            six.
          </p>
          <p>
            The tribunal sat in open court and the newspapers printed the defendants' arguments
            across the island. That was the regime's mistake. On the defence bench that spring sat
            Chen Shui-bian <span class="hz">陳水扁</span>, Frank Hsieh <span class="hz">謝長廷</span>, Su Tseng-chang <span class="hz">蘇貞昌</span>, Chang
            Chun-hsiung <span class="hz">張俊雄</span> and Chiang Peng-chien <span class="hz">江鵬堅</span>. Within a generation one of them was president, three
            had served as premier, and one had founded the party that carried him there. Annette Lu <span class="hz">呂秀蓮</span>, sentenced to twelve years for sedition, became his vice
            president.
          </p>
        </div>
        <figure class="fig">
          <Image
            src={formosaMagazine}
            alt="The first issue of Formosa magazine on display: a red-orange cover with large grey characters 美麗島 above the words Formosa, The Magazine of Taiwan's Democratic Movement, August 16, 1979"
            widths={[480, 800, 1200]}
            sizes="(min-width: 62rem) 896px, 100vw"
            loading="lazy"
          />
          <figcaption>
            The first issue of <em>Formosa</em>, dated 16 August 1979: &ldquo;The Magazine of
            Taiwan's Democratic Movement.&rdquo;
            <span class="fig-credit"
              >Photo: Christopher Adams, CC BY 2.0, via Wikimedia Commons.</span
            >
          </figcaption>
        </figure>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Five · The warning</p>
          <h2>Twenty four hours</h2>
          <p>His interrogators had a line ready for him.</p>
          <blockquote>
            <p>
              Don't tell your family about the &ldquo;treatment&rdquo; you received, or else
              &ldquo;unfavorable&rdquo; things could happen to your relatives.
            </p>
            <cite>Taiwan Garrison Command interrogators, as recorded by Taiwan Communiqué</cite>
          </blockquote>
          <p>
            On 27 February 1980 his wife Fang Su-min <span class="hz">方素敏</span> and his mother
            Yu A-mei <span class="hz">游阿妹</span> were allowed to see him for the first time. He
            had been beaten badly enough that his mother kept asking about it.
          </p>
          <blockquote>
            <p>Have you been tortured?</p>
            <p>Don't ask me such questions. You know what kind of things happen here.</p>
            <cite
              >Yu A-mei and her son, Jingmei detention centre <span class="hz">景美看守所</span>,
              27 February 1980</cite
            >
          </blockquote>
          <p>She had a day left.</p>
        </div>
        <figure class="fig">
          <Image
            src={firstCourt}
            alt="The restored First Court at Jingmei: a long dark wooden judges' bench with name plates and high-backed chairs, flanked by flags of the Republic of China, behind a metal defendants' rail"
            widths={[480, 800, 1200]}
            sizes="(min-width: 62rem) 896px, 100vw"
            loading="lazy"
          />
          <figcaption>
            The First Court at Jingmei, preserved at what is now the National Human Rights
            Museum. The Kaohsiung Eight faced the military tribunal in this room in March 1980.
            <span class="fig-credit">Photo: 吳蕙宇, CC BY-SA 4.0, via Wikimedia Commons.</span>
          </figcaption>
        </figure>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Six · The record of the day</p>
          <h2>28 February 1980</h2>
          <p>
            Times below are taken from the High Prosecutors Office reinvestigation report of 2009
            and the Control Yuan's closing report of 2023. The house had been under round-the-clock
            surveillance and a Garrison Command <span class="hz">警總</span> wiretap since his
            arrest, eleven weeks earlier.
          </p>
        </div>
        <div class="plate">
          <div class="log">
            <div class="log-head">
              <span>Xinyi Road · Lane 31, No. 16</span>
              <span>Prosecutors' reconstruction, 2009 and 2023</span>
            </div>
            <div class="log-scroll">
              <table>
                <tbody>
                  <tr>
                    <td class="t">02:00</td>
                    <td
                      >Fang Su-min gets home by taxi from the Jingmei military law court compound,
                      where the Kaohsiung proceedings are running.</td
                    >
                  </tr>
                  <tr>
                    <td class="t">~10:00</td>
                    <td
                      >She leaves again for the court. She is away from the house for the rest of
                      the day.</td
                    >
                  </tr>
                  <tr>
                    <td class="t">11:30</td>
                    <td>Fang telephones home. Lin Ting-chun answers. Nothing is wrong.</td>
                  </tr>
                  <tr>
                    <td class="t">11:55</td>
                    <td
                      >Bruce Jacobs <span class="hz">家博</span>, an Australian academic and family
                      friend, telephones from International House and talks to the twins for
                      several minutes. They are alive and unhurt.</td
                    >
                  </tr>
                  <tr>
                    <td class="t">~12:00</td>
                    <td
                      >Lin Huan-chun comes home from school and rings the bell. Someone is already
                      inside.</td
                    >
                  </tr>
                  <tr class="mark">
                    <td class="t">12:10</td>
                    <td
                      >Fang telephones home three times. Nobody picks up. She hands her house key
                      to Tien Chiu-chin.</td
                    >
                  </tr>
                  <tr>
                    <td class="t">13:07</td>
                    <td
                      >A neighbour, Chen Yung-chung <span class="hz">陳永忠</span>, sees a man of
                      about thirty walking away from the house.</td
                    >
                  </tr>
                  <tr class="mark">
                    <td class="t">13:10</td>
                    <td
                      >Someone inside the house dials 104, the directory service, and asks for the
                      number of the Gold Piano restaurant <span class="hz">金琴西餐廳</span> on
                      Nanjing East Road.</td
                    >
                  </tr>
                  <tr class="mark">
                    <td class="t">13:12</td>
                    <td
                      >He calls it and asks for a Mr Wang Chun-feng <span class="hz">王春風（發）</span>. Eight seconds. No such man was ever
                      found, and the prosecutors wrote the third syllable of the name in phonetic
                      script because they could not establish which character it was.<span
                        class="erased"
                        >Wiretap logged both calls · no transcript written for either · tapes
                        gone</span
                      ></td
                    >
                  </tr>
                  <tr>
                    <td class="t">13:40</td>
                    <td
                      >Tien Chiu-chin <span class="hz">田秋堇</span>, Lin's twenty six year old
                      assistant, arrives by bus. She finds Lin Huan-chun in the main bedroom, badly
                      wounded and conscious. <em>Auntie Tien, don't shake me, it hurts so much.</em
                      ></td
                    >
                  </tr>
                  <tr>
                    <td class="t">14:16</td>
                    <td
                      >The Da'an precinct <span class="hz">大安分局</span> logs the report. Tien
                      made the call on the tapped telephone. The officer asked her which Lin
                      Yi-hsiung she meant.</td
                    >
                  </tr>
                  <tr>
                    <td class="t">after</td>
                    <td
                      >Yu A-mei, sixty, is found dead on the basement stairs. The twins are found
                      in the basement below her. Lin Liang-chun <span class="hz">林亮均</span> and
                      Lin Ting-chun <span class="hz">林亭均</span>, six years old, born on the
                      second of February.</td
                    >
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="log-foot">
              No forced entry. Nothing taken. Twelve fingerprints and six palm prints were lifted.
              All but one were matched to victims, family, associates, or a Taipei police forensic
              officer. That one print has never been matched.
            </div>
          </div>
        </div>
        <div class="prose mt">
          <p>She had called from the telephone the state was listening to.</p>
          <blockquote>
            <p class="han">你也太假了吧，你們監控林家這麼久，現在問我哪一個林義雄？</p>
            <p>
              That is far too fake. You have been watching the Lin house all this time, and now you
              ask me which Lin Yi-hsiung.
            </p>
            <cite>Tien Chiu-chin, recalling the call · Mirror Media, 2026</cite>
          </blockquote>
          <p>She rode with the girl to Renai Hospital.</p>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Seven · The tape</p>
          <h2>Project Rainbow</h2>
          <p>
            The tap on the Lin house was not a special measure. It ran under <span class="hz">彩虹專案</span>, Project Rainbow, the Garrison Command's standing
            wiretap programme against opposition figures, which had been listening to the tangwai
            for years. Lin himself had been watched since 1977, the year Yilan elected him, by
            informants, bugs and telephone interception. The house was one line among many.
          </p>
          <p>
            The National Security Bureau <span class="hz">國家安全局</span> account of the erased
            recording is that it did not know a crime had occurred, so the reel was overwritten in
            the ordinary course of business.
          </p>
          <p>Tien Chiu-chin called the police from the tapped telephone.</p>
          <p>
            Bruce Jacobs, the Australian academic who had telephoned the house at 11:55 and heard
            the twins alive, was named a suspect for it. He was held three months under
            round-the-clock &ldquo;protection&rdquo; and sleep-deprived questioning, barred from
            leaving, never charged, and blacklisted from Taiwan until 1992. On 16 November 2018 the
            foreign minister presented him with the Order of Brilliant Star with Grand Cordon <span class="hz">大綬景星勳章</span>. He died a year later.
          </p>
          <p>
            Yu Shyi-kun <span class="hz">游錫堃</span>, later premier, was interviewed more than
            twenty times because a newspaper had described a tall, thin youth. His employment
            records cleared him.
          </p>
          <blockquote>
            <p>
              Although there is no direct evidence proving that intelligence personnel were
              involved, the massacre took place while the Lin residence was under the Garrison
              Command's inescapable and tight surveillance. By ordinary reasoning, how could it
              have been accomplished unless the intelligence units carried it out or tacitly
              allowed it to happen?
            </p>
            <cite
              >Control Yuan <span class="hz">監察院</span> closing report, approved 21 February
              2023</cite
            >
          </blockquote>
          <p>
            That report found six failings by the security apparatus: interference in the judicial
            investigation, misdirection of it, obstruction of evidence collection, media
            manipulation, harbouring of suspects, and use of organised crime. It named a standing
            committee through which the Garrison Command steered the criminal inquiry. It found no
            direct evidence of who held the knife.
          </p>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Eight · The survivor</p>
          <h2>The schoolbag</h2>
          <p>
            Lin Huan-chun <span class="hz">林奐均</span> took six wounds. One to the chest, through
            the lung. Five to the back. The first thrust caught the bag on her shoulders.
          </p>
          <blockquote>
            <p class="han">
              當我進到房間，還來不及放下書包，突然間我不自覺地側了一下身子……如果當時我沒有側身，這第一刀一定使我當場斃命。
            </p>
            <p>
              When I came into the room, before I could even put down my schoolbag, I suddenly
              turned my body to one side without knowing why. If I had not turned, that first
              thrust would certainly have killed me on the spot.
            </p>
            <cite>Lin Huan-chun, from her 2004 memoir <span class="hz">你是我最愛</span></cite>
          </blockquote>
          <p>
            She went into a coma at Renai Hospital <span class="hz">仁愛醫院</span>. For four
            months nobody told her that her grandmother and her sisters were dead.
          </p>
          <p>
            She left for San Diego with her mother in 1981. She came to faith at eighteen. Indiana
            for a music degree, Columbia for a master's, and in 2004 a Golden Melody Award for a
            gospel record made for her family and her faith.
          </p>
          <blockquote>
            <p>
              On Feb. 28, 1980, a murderer broke into my home. I was stabbed several times and left
              to die. My grandmother died while calling out my name.
            </p>
            <p>God has healed me and enabled me to forgive the murderer.</p>
            <cite>Judy Linton (Lin Huan-chun), Taipei Times, 26 September 2003</cite>
          </blockquote>
          <p>
            She married an American Presbyterian named Joel Linton and moved back. They plant
            churches in Yilan County. Her father was born there.
          </p>
          <p>Their daughter Ashlyn co-hosts a podcast. One episode is about her grandparents.</p>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Nine · The widow's campaign</p>
          <h2>A hundred and twenty one thousand votes</h2>
          <p>
            Fang Su-min spent that whole day at the military court. Four people were in the house
            when she left it. One of them was alive when the day ended.
          </p>
          <p>
            She took the daughter to California in 1981. In October 1983 she came back alone and
            stood for the Legislative Yuan. The press called it the holy war of the mother. She
            took roughly a hundred and twenty one thousand votes, the third-highest total in the
            country, and used the seat to argue for the release of other women's husbands.
          </p>
          <p>
            Her own was released on 15 August 1984, in the middle of her term, after four years and
            eight months in custody. Kao Chun-ming <span class="hz">高俊明</span> walked out the
            same day. He was general secretary of the Presbyterian Church in Taiwan <span class="hz">台灣基督長老教會</span>, and had hidden Shih Ming-teh from the
            manhunt, and who in 1977 had signed a declaration urging the government to let Taiwan
            become a new and independent country. He had written his will before it went out.
          </p>
          <p>
            Lin refused to hold a funeral for his mother and his daughters while nobody had been
            caught. He held it on 1 January 1985, nearly five years late. Sixty vehicles followed
            the hearse to Yilan.
          </p>
          <p>
            In 1991 he and Fang gave away most of what they owned and founded an education
            foundation in the county they came from, the Chilin <span class="hz">慈林教育基金會</span>.
          </p>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Ten · The frame</p>
          <h2>Forty years, closing and opening</h2>
          <p>
            The family story sits inside a national one. The rail beside each entry marks which
            side of 15 July 1987 it falls on: the years the state could do this and answer to
            nobody, and the years after it lost that.
          </p>
        </div>
        <div class="plate">
          <div class="tl">
            <div class="tl-row">
              <div class="tl-date">1947 · 02 · 28</div>
              <div class="tl-body">
                <h3>The 228 Incident <span class="hz">二二八事件</span></h3>
                <p>
                  A confiscated tray of cigarettes, a pistol-whipped widow, a crowd fired on.
                  Troops land from the mainland on 8 March; the sweeps run to mid-May. The 1992
                  government commission estimates eighteen to twenty eight thousand dead.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1949 · 05 · 19</div>
              <div class="tl-body">
                <h3>Martial law</h3>
                <p>
                  Chen Cheng declares it over Taiwan and Penghu, effective at midnight on the 20th.
                  It holds for thirty eight years and fifty six days.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1960 · 09 · 04</div>
              <div class="tl-body">
                <h3>Lei Chen <span class="hz">雷震</span> arrested</h3>
                <p>
                  <em>Free China</em> <span class="hz">自由中國</span> had attacked Chiang
                  Kai-shek's third term, and its founder was assembling an opposition party. Ten
                  years. Chiang fixed the sentence before the trial.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1977 · 08 · 16</div>
              <div class="tl-body">
                <h3>The Presbyterian declaration <span class="hz">人權宣言</span></h3>
                <p>
                  &ldquo;&hellip;we urge our government to face reality and to take effective
                  measures whereby Taiwan may become a new and independent country.&rdquo; The
                  first open call for it from a major institution inside the country. Kao Chun-ming
                  and a dozen other church leaders wrote their wills the night before it went out.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1977 · 11 · 19</div>
              <div class="tl-body">
                <h3>Chungli <span class="hz">中壢事件</span></h3>
                <p>
                  Ballots destroyed in front of witnesses in Taoyuan. Police protected the
                  returning officer instead of investigating. A crowd besieged the station and
                  burned it, and police shot two young men dead. First mass street protest on the
                  island since 228. Hsu Hsin-liang <span class="hz">許信良</span> won the county by
                  nearly ninety thousand votes.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1979 · 12 · 10</div>
              <div class="tl-body">
                <h3>Kaohsiung <span class="hz">美麗島事件</span></h3>
                <p>
                  <em>Formosa</em> magazine's Human Rights Day rally. Tear gas, then mass arrests,
                  then a military tribunal that the regime unwisely held in the open.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1980 · 02 · 28</div>
              <div class="tl-body">
                <h3>Xinyi Road <span class="hz">林宅血案</span></h3>
                <p>
                  Yu A-mei and the Lin twins killed. Lin Huan-chun survives six stab wounds. Nobody
                  has ever been charged.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1981 · 07 · 03</div>
              <div class="tl-body">
                <h3>Chen Wen-chen <span class="hz">陳文成</span></h3>
                <p>
                  A Carnegie Mellon statistician home for the summer, taken from his house on 2
                  July and held by the Garrison Command some twelve or thirteen hours. Found at
                  dawn the next day beside a fire escape at National Taiwan University. Thirteen
                  broken ribs. Cyril Wecht, the American pathologist his family brought in, ruled
                  it homicide.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1984 · 10 · 15</div>
              <div class="tl-body">
                <h3>Henry Liu <span class="hz">江南 / 劉宜良</span></h3>
                <p>
                  A Taiwanese-American journalist shot in his garage in Daly City, California, by
                  two Bamboo Union <span class="hz">竹聯幫</span> gunmen sent by their leader, who
                  had taken the commission from the Defence Ministry's intelligence director. The
                  scandal cost Chiang Ching-kuo his succession plan and a great deal of Washington.
                </p>
              </div>
            </div>
            <div class="tl-row">
              <div class="tl-date">1986 · 09 · 28</div>
              <div class="tl-body">
                <h3>The DPP forms illegally <span class="hz">民主進步黨</span></h3>
                <p>
                  One hundred and thirty two people at the Grand Hotel <span class="hz">圓山大飯店</span> turn a candidate-nomination meeting into a
                  political party. Party elders press for mass arrests. Chiang Ching-kuo, seventy
                  six and in a wheelchair, rules against it. The times are changing, he said around
                  then, and the KMT cannot afford to be too proud.
                </p>
              </div>
            </div>
            <div class="tl-row after pivot">
              <div class="tl-date">1987 · 07 · 15</div>
              <div class="tl-body">
                <h3>Martial law ends</h3>
                <p>
                  Chiang signs the order on the 14th; it takes effect at midnight. Twenty three
                  political prisoners are released that day. The National Security Act that
                  replaces it keeps a good deal of the old machinery.
                </p>
              </div>
            </div>
            <div class="tl-row after">
              <div class="tl-date">1990 · 03 · 16</div>
              <div class="tl-body">
                <h3>Wild Lily <span class="hz">野百合學運</span></h3>
                <p>
                  Nine students sit down in front of the Chiang Kai-shek Memorial <span class="hz">中正紀念堂</span>. Six days later there are thousands. Lee
                  Teng-hui <span class="hz">李登輝</span> receives fifty three student and faculty
                  representatives, commits to a National Affairs Conference <span class="hz">國是會議</span>, and defers their other three demands to it.
                </p>
              </div>
            </div>
            <div class="tl-row after">
              <div class="tl-date">1991 · 12 · 31</div>
              <div class="tl-body">
                <h3>The ten thousand year parliament retires <span class="hz">萬年國會</span></h3>
                <p>
                  Members elected on the mainland in 1947 and 1948 finally stand down after forty
                  three years, forced out by Interpretation No. 261 <span class="hz">釋字第261號</span>. The Temporary Provisions had been abolished
                  on 1 May.
                </p>
              </div>
            </div>
            <div class="tl-row after">
              <div class="tl-date">1996 · 03 · 23</div>
              <div class="tl-body">
                <h3>The first direct presidential election</h3>
                <p>
                  Beijing fired missiles into the water off Keelung and Kaohsiung that month and
                  ran live-fire exercises near Penghu. Washington sent two carrier groups. Turnout
                  was 76 percent.
                </p>
              </div>
            </div>
            <div class="tl-row after">
              <div class="tl-date">2000 · 03 · 18</div>
              <div class="tl-body">
                <h3>Power changes hands</h3>
                <p>
                  Chen Shui-bian, who defended the Kaohsiung Eight, wins with 39.3 percent. Annette
                  Lu, who was one of them, becomes vice president. Lin Yi-hsiung, party chairman
                  through the campaign, steps down on 20 April and reaches for Robert Frost to
                  explain why he will not stand again.
                </p>
              </div>
            </div>
            <div class="tl-row after">
              <div class="tl-date">2023 · 02 · 21</div>
              <div class="tl-body">
                <h3>The Control Yuan closes its file</h3>
                <p>
                  Six findings of interference by the security services in the investigation of the
                  murders. Over four thousand documents recommended for declassification. Still no
                  name for the man with the knife.
                </p>
              </div>
            </div>
          </div>
          <div class="tl-legend">
            <span><i class="before"></i> Under martial law</span>
            <span><i class="after-swatch"></i> After 15 July 1987</span>
          </div>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Eleven · Unfinished</p>
          <h2>Forty six years, one fingerprint</h2>
          <p>
            The case has been reopened four times: 1996, 1998, 2007, and 2009. The 2009 review,
            ordered by President Ma Ying-jeou, surfaced the record of the 13:12 call and the fact
            that the tape was gone. It closed after four months for want of forensic evidence.
            Critics read it as an exercise in clearing the security services rather than finding
            the killer.
          </p>
          <p>
            The old twenty five year limitation period expired long ago. In May 2019 the
            legislature abolished the limitation entirely for offences carrying death or life
            imprisonment. Prosecutors confirmed in February 2026 that the file cannot be closed by
            the calendar. It sits with the High Prosecutors' Office and the Criminal Investigation
            Bureau's cold case unit.
          </p>
          <p>
            Nationally the accounting has gone further. The Transitional Justice Commission <span class="hz">促轉會</span> ran from 31 May 2018 to 30 May 2022, put the White
            Terror database online, and overturned the convictions of 5,983 people. Compensation
            frameworks have paid out for both 228 and the White Terror. A commission survey in
            October 2020 counted 1,542 authoritarian symbols standing in public space, from statues
            to street names. Fewer than a quarter had been dealt with.
          </p>
          <p>
            In February 2026 a production company announced it had finished shooting a feature film
            about the murders, <em>Murder of the Century</em> <span class="hz">世紀血案</span>. It
            had not contacted the family. The wrap press conference was held on 1 February. The
            coverage ran the next morning, on what would have been the twins' fifty second
            birthday. The director, Hsu Kun-hua <span class="hz">徐琨華</span>, is the grandson of
            Hsu Mei-lin <span class="hz">徐梅鄰</span>, the Garrison Command's spokesman in 1980.
            Material reported by New Bloom and Business Today as having leaked from the script
            placed the killings at the door of the independence movement. Nobody outside the
            production has seen the pages.
          </p>
          <p>
            The cast turned on it. Six actors signed a joint legal statement saying their contracts
            had carried a written warranty that the rights were cleared, and demanded that their
            performances never be used in any form. Nana Lee <span class="hz">李千娜</span> gave
            her entire fee to the family's foundation. The culture minister, Li Yuan <span class="hz">李遠</span>, said the film tramples on Taiwan's history and its
            people. Production stopped.
          </p>
          <p>
            Lee then filed a fraud complaint. On 6 May 2026 the Taipei District Prosecutors Office
            summoned the producer, Kuo Mu-sheng <span class="hz">郭木盛</span>, and the company's
            owner, Sam Su <span class="hz">蘇敬軾</span>, as defendants. On 14 August prosecutors
            declined to charge them, holding that no explicit guarantee of the family's consent
            could be proved, and that consent is in any case not the only reason an actor takes a
            part. Asked whether the film will ever be released, Kuo said he could not answer that
            yet. Su had earlier proposed that they finish the edit and then go and see Lin
            Yi-hsiung about it.
          </p>
          <blockquote>
            <p class="han">
              自古以來，像二二八事件、林家血案這種慘事並不稀罕。世界各國，只要有專制政權存在，這種事就會發生。
            </p>
            <p>
              Tragedies like the 228 Incident and the Lin family massacre have never been rare. In
              any country in the world, so long as an authoritarian regime exists, this kind of
              thing will happen.
            </p>
            <cite>Lin Yi-hsiung</cite>
          </blockquote>
        </div>
      </section>

      <section class="sec">
        <div class="prose">
          <p class="kicker">Twelve · The basement</p>
          <h2>義光</h2>
          <p>
            The house could not be rented and could not be sold. In 1982 Presbyterian pastors and
            church members raised the money, bought it from Fang Su-min, and made it a church.
            Gikong <span class="hz">義光教會</span>. They hold a memorial service in it every 28
            February.
          </p>
        </div>
        <figure class="fig">
          <Image
            src={gikongChurch}
            alt="The front of Gikong Presbyterian Church: a modest brick row house with red-tiled eaves, a vertical sign reading 義光基督長老教會, and people gathered inside the open door at the top of red-brick steps"
            widths={[480, 800, 1200]}
            sizes="(min-width: 62rem) 896px, 100vw"
            loading="lazy"
          />
          <figcaption>
            Gikong Presbyterian Church on the morning of 28 February 2011, the anniversary. The
            house number by the door still reads 16.
            <span class="fig-credit">Photo: MiNe, CC BY 2.0, via Wikimedia Commons.</span>
          </figcaption>
        </figure>
        <div class="prose mt">
          <p>The basement where the three of them died is the children's Sunday school room.</p>
          <p>
            The pastor takes visitors down there. In the seam where the staircase meets the wall
            there are still stains.
          </p>
          <blockquote>
            <p class="han">那些痕跡，也是怎樣都清不掉的。</p>
            <p>Those traces, too, simply cannot be cleaned away.</p>
            <cite
              >Wang Ming-tse <span class="hz">王銘澤</span>, pastor of Gikong Presbyterian
              Church</cite
            >
          </blockquote>
          <p>
            In April 2014 Lin Yi-hsiung walked back into that building, sat down, and stopped
            eating until the government halted construction of the fourth nuclear plant. It took
            nine days. He was seventy two.
          </p>
        </div>
        <figure class="fig fig--portrait">
          <Image
            src={linYiHsiung}
            alt="Black and white portrait of Lin Yi-hsiung in a woven bamboo farmer's hat and plaid scarf, faintly smiling, a volunteer name tag reading 林義雄 pinned to his shirt"
            widths={[360, 520, 832]}
            sizes="(min-width: 32rem) 416px, 100vw"
            loading="lazy"
          />
          <figcaption>
            Lin Yi-hsiung arriving at the church on 22 April 2014 to begin his fast against the
            fourth nuclear plant.
            <span class="fig-credit">Photo: 李忠衛, CC BY-SA 2.0, via Wikimedia Commons.</span>
          </figcaption>
        </figure>
        <div class="prose mt">
          <p>
            In August 2025 the Ministry of Culture designated the church a site of transitional
            justice significance <span class="hz">具轉型正義意涵場址</span>. The congregation had
            applied for the designation themselves. Nobody had ever done that before.
          </p>
        </div>
      </section>
    </div>

    <section class="closer section--tint">
      <div class="wrap">
        <div class="prose">
          <p>
            Taiwan votes now. The parliament turns over. The presidency has changed hands in both
            directions, more than once.
          </p>
          <p>The file on the house is still open. The fingerprint is still unmatched.</p>
          <p>
            A country that can argue about its own worst day in public, with the records
            declassified and the survivors alive to correct them, has arrived somewhere. Not at a
            clean ending. At an argument it is allowed to have.
          </p>
        </div>
      </div>
    </section>

