---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RootsGraph from '../../components/RootsGraph.astro';
import RootsConnection from '../../components/RootsConnection.astro';
import { NODES } from '../../data/roots';
import {
  CATEGORIES,
  FILTER_KINDS,
  ROOTS_NOTE,
  clientData,
  incoming,
  layoutTall,
  layoutWide,
  nodeById,
  nodesIn,
  outgoing,
  partsInOrder,
  pathOf,
  slugOf,
  typeset,
  validateRoots,
} from '../../lib/roots';
import '../../styles/roots.css';

validateRoots();

const title = 'Roots of the Constitution';
const description =
  typeset("An interactive map of the sources behind the U.S. Constitution: Magna Carta, Locke, Montesquieu, the state constitutions, the Federalist, the Anti-Federalists, and the founders' letters, each linked to the original text.");

const partCount = partsInOrder().length;
const sourceCount = NODES.length - partCount - 1;
const wide = layoutWide();
const tall = layoutTall();
// "<" is escaped so no text in the data can close the script tag early.
const payload = JSON.stringify(clientData()).replace(/</g, '\\u003c');
---

<BaseLayout title={title} description={description}>
  <div class="roots" data-roots>
    {/* Chooses the view before the map is drawn, so it never flashes from one to the other.
        3D is the default on a wide screen with WebGL. A phone, a reduced-motion setting, or
        no WebGL gets the flat map. A saved choice wins over the default. */}
    <script is:inline>
      (function () {
        var root = document.currentScript.parentElement;
        var view = '2d';
        try {
          var saved = null;
          try {
            saved = localStorage.getItem('roots-view');
          } catch (e) {}
          var small = window.matchMedia('(max-width: 767px)').matches;
          var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var want = saved === '2d' || saved === '3d' ? saved : small || calm ? '2d' : '3d';
          if (want === '3d') {
            var c = document.createElement('canvas');
            if (c.getContext('webgl2') || c.getContext('webgl')) view = '3d';
            else root.setAttribute('data-webgl', 'no');
          }
        } catch (e) {}
        root.setAttribute('data-view', view);
      })();
    </script>
    <header class="wrap intro">
      <p class="kicker">An interactive map</p>
      <h1>{title}</h1>
      <div class="intro__text">
        <p class="lede">
          The Constitution did not come from nowhere. Its framers drew on English charters,
          Enlightenment thinkers, their own state constitutions, and the hard lessons of the
          Articles of Confederation. Then the country argued about the result in newspapers and
          private letters. This map shows {sourceCount} of those sources and how each one connects
          to the Constitution, or to the part of it that the source shaped, explains, or disputes.
        </p>
        <p>
          The Constitution sits in the middle with its parts around it: the Preamble, the
          articles, the Bill of Rights, and the later amendments. Select a part to see every
          source tied to it. Select any source to see what it is, who wrote it, and how it ties
          to the others. A
          solid line means one source shaped another. A dotted line means it explains the other.
          A dashed line marks a dispute. Use the buttons to show or hide each kind of line, or{' '}
          <a href="#all-sources">skip to the full list</a> below the map.
        </p>
      </div>
    </header>

    <section class="map" aria-labelledby="map-heading">
      <h2 id="map-heading" class="sr-only">The map</h2>
      <div class="map__inner">

      <div class="viewbar" data-viewbar hidden>
        <div class="seg" role="group" aria-label="Map view">
          <button type="button" class="seg__btn" data-set-view="2d" aria-pressed="true">2D</button>
          <button type="button" class="seg__btn" data-set-view="3d" aria-pressed="false">3D</button>
        </div>
        <p class="viewnote" id="r3d-note" data-view-note>
          The 3D view is drawn for sight and a pointer. With a keyboard or a screen reader, use the{' '}
          <button type="button" class="textbtn" data-set-view="2d">2D map</button> or the{' '}
          <a href="#all-sources">list of all sources</a>. They hold the same sources and connections.
        </p>
        <p class="viewnote viewnote--fail" data-view-fail hidden>
          The 3D view needs WebGL, which this browser is not offering. The 2D map shows the same
          sources and connections.
        </p>
      </div>

      <div class="toolbar">
        <ul class="legend" aria-label="Kinds of source">
          {
            CATEGORIES.map((c) => (
              <li data-cat={c.id}>
                <span class="dot" />
                {c.name}
              </li>
            ))
          }
        </ul>

        <div class="filter" role="group" aria-label="Show or hide kinds of connection" data-filter hidden>
          {
            FILTER_KINDS.map((k) => (
              <button type="button" class="chip" data-kind={k.id} aria-pressed="true">
                <svg class="stroke" data-kind={k.id} viewBox="0 0 30 10" aria-hidden="true">
                  <line x1="1" y1="5" x2="29" y2="5" />
                </svg>
                {k.name}
              </button>
            ))
          }
        </div>

        {/* Without JavaScript the buttons cannot filter, so the same three line styles show as a plain key. */}
        <ul class="legend legend--lines" aria-label="Kinds of connection" data-key>
          {
            FILTER_KINDS.map((k) => (
              <li>
                <svg class="stroke" data-kind={k.id} viewBox="0 0 30 10" aria-hidden="true">
                  <line x1="1" y1="5" x2="29" y2="5" />
                </svg>
                {k.name}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="stage">
        <div class="plate">
          <RootsGraph layout={wide} />
          <RootsGraph layout={tall} />
          <div class="r3d" data-r3d>
            <div class="r3d__view" data-r3d-view></div>
            <p class="r3d__loading" data-r3d-loading>Loading the 3D view</p>
            <div class="r3d__tools" role="group" aria-label="3D view controls">
              <button type="button" class="r3d__tool" data-r3d-in aria-label="Zoom in">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
              </button>
              <button type="button" class="r3d__tool" data-r3d-out aria-label="Zoom out">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg>
              </button>
              <button type="button" class="r3d__tool r3d__tool--text" data-r3d-reset>Reset view</button>
            </div>
          </div>
          <p class="hint hint--2d" data-hint hidden>
            Select a source or a line for details. Arrow keys move between sources. Esc closes.
          </p>
          <p class="hint hint--3d" data-hint hidden>
            Drag to rotate. Click the map, then scroll to zoom, or pinch. Right drag or two fingers
            to pan. Select a source or a line for details.
          </p>
        </div>

        <aside class="rp" id="roots-panel" aria-label="Details" data-panel data-open="false">
          <div class="rp__empty" data-empty>
            <p class="rp__eyebrow">Details</p>
            <p class="rp__prompt">Select a source on the map.</p>
            <p class="rp__help">
              You will see who wrote it, when, a link to the original text, and each of its
              connections. Select a line to read about that one connection.
            </p>
          </div>
          <div class="rp__body" data-body hidden></div>
        </aside>
      </div>

      <p class="sr-only" role="status" data-status></p>
      </div>
    </section>

    <div class="wrap after-map">
      <p class="note">{ROOTS_NOTE}</p>
    </div>

    <section class="wrap list" id="all-sources" aria-labelledby="list-heading">
      <header class="list__head">
        <h2 id="list-heading">All sources and connections</h2>
        <p>
          The Constitution, its {partCount} parts, and the same {sourceCount} sources as the map,
          with every connection in plain text. Each one has its own page.
        </p>
      </header>

      {
        CATEGORIES.map((c) => (
          <section class="group" data-cat={c.id} aria-labelledby={`group-${c.id}`}>
            <h3 id={`group-${c.id}`}>
              <span class="dot" />
              {c.name}
            </h3>
            <div class="sources">
              {nodesIn(c.id).map((node) => {
                const from = outgoing(node.id);
                const to = incoming(node.id);
                return (
                  <article class="src" id={`source-${slugOf(node)}`}>
                    <h4>
                      <a href={pathOf(node)}>{typeset(node.full)}</a>
                    </h4>
                    <p class="src__meta">
                      {typeset(node.author)} · {node.year}
                    </p>
                    <p class="src__about">{typeset(node.about)}</p>
                    <p class="src__link">
                      <a class="ext" href={node.href} target="_blank" rel="noopener">
                        Read it at {typeset(node.site)}
                        <span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    </p>
                    {from.length > 0 && (
                      <details class="src__more">
                        <summary>
                          {from.length} {from.length === 1 ? 'connection' : 'connections'} from this source
                        </summary>
                        <ul class="conns">
                          {from.map((edge) => (
                            <RootsConnection edge={edge} self={node.id} heading="h5" />
                          ))}
                        </ul>
                      </details>
                    )}
                    {to.length > 0 && (
                      <p class="src__from">
                        <span>Connected from:</span>{' '}
                        {to.map((edge, i) => (
                          <>
                            {i > 0 && ', '}
                            <a href={`#source-${slugOf(nodeById(edge.from))}`}>
                              {typeset(nodeById(edge.from).label)}
                            </a>
                          </>
                        ))}
                      </p>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </section>
  </div>

  <script is:inline type="application/json" id="roots-data" set:html={payload} />
  <script>
    import '../../scripts/roots-map';
  </script>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(2.25rem, 5vw, 3.25rem) clamp(1.25rem, 3vw, 1.75rem);
  }

  .intro__text {
    max-width: var(--measure);
  }

  .intro__text p:last-child {
    margin-bottom: 0;
  }

  /* A full-width parchment band. The map gets more room than the text column
     so its labels stay a readable size. */
  .map {
    background: var(--r-surface);
    border-block: 1px solid var(--r-rule);
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2.25rem);
  }

  .map__inner {
    width: 100%;
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .after-map {
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 2rem;
    margin-bottom: 1rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .legend[hidden] {
    display: none;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter[hidden] {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.95rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    min-height: 2.5rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .chip:hover {
    border-color: var(--purple);
    color: var(--purple-dark);
  }
  .chip[aria-pressed='false'] {
    border-color: var(--rule);
    background: var(--paper-alt);
    color: var(--ink-muted);
    text-decoration: line-through;
  }

  .stage {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .plate {
    min-width: 0;
  }

  .hint {
    margin: 0.5rem 0 0.25rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .hint[hidden] {
    display: none;
  }

  /* One drawing per screen shape. The hidden one is out of the tab order too. */
  .plate :global(.rg--wide) {
    display: none;
  }
  .plate :global(.rg--tall) {
    max-width: 460px;
    margin-inline: auto;
  }

  @media (min-width: 820px) {
    .plate :global(.rg--wide) {
      display: block;
    }
    .plate :global(.rg--tall) {
      display: none;
    }
  }

  @media (min-width: 1120px) {
    .stage {
      grid-template-columns: minmax(0, 1fr) 350px;
    }
  }

  @media (max-width: 819px) {
    .hint--2d {
      display: none;
    }
  }

  /* The 2D / 3D switch */
  .viewbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    margin-bottom: 1rem;
  }
  .viewbar[hidden] {
    display: none;
  }

  .seg {
    display: inline-flex;
    flex: none;
    padding: 3px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }
  .seg__btn {
    min-width: 3.4rem;
    min-height: 2.25rem;
    padding: 0.3rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .seg__btn:hover {
    color: var(--purple-dark);
  }
  .seg__btn[aria-pressed='true'] {
    background: var(--r-center);
    color: #fff;
  }

  .viewnote {
    flex: 1 1 22rem;
    max-width: 46rem;
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .viewnote[hidden] {
    display: none;
  }
  .textbtn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--purple);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .textbtn:hover {
    color: var(--purple-dark);
  }

  /* List view */
  .list {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .list__head {
    max-width: var(--measure);
    margin-bottom: 1rem;
  }
  .list__head p {
    color: var(--ink-muted);
  }

  .group {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .group h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--cat);
  }

  .sources {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    align-items: start;
  }

  .src {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem 1.25rem;
    /* Leaves room when a "Connected from" link jumps here. */
    scroll-margin-top: 1rem;
  }
  .src:target {
    border-color: var(--purple);
  }

  .src h4 {
    font-size: 1.2rem;
    margin-bottom: 0.2rem;
  }
  .src h4 a {
    color: var(--ink);
    text-decoration: none;
  }
  .src h4 a:hover {
    color: var(--purple);
    text-decoration: underline;
  }

  .src__meta {
    margin: 0 0 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .src__about {
    margin: 0 0 0.5rem;
  }

  .src__link {
    margin: 0 0 0.9rem;
    font-size: 0.925rem;
    font-weight: 600;
  }

  .src .conns {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .src__more {
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .src__more summary {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--purple);
    cursor: pointer;
  }
  .src__more summary:hover {
    color: var(--purple-dark);
  }
  .src__more :global(.conn:last-child) {
    padding-bottom: 0.25rem;
  }

  .src__from {
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
</style>
