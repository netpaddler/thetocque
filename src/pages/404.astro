---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="wrap page">
    <h1>That page has moved on</h1>
    <p class="lede">
      The link may be out of date. The essays are all still here — try the archive, or head
      back to the beginning.
    </p>
    <p class="actions">
      <a class="btn" href="/blog/">Browse the essays</a>
      <a class="btn btn--ghost" href="/">Return home</a>
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 9vw, 6rem);
    max-width: var(--measure);
  }
  .lede {
    font-size: 1.15rem;
    color: var(--ink-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
