---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<a class="card" href={product.href} rel="noopener">
  <div class="shot">
    <Image
      src={product.image}
      alt={product.alt}
      widths={[240, 360]}
      sizes="(max-width: 560px) 45vw, 280px"
      loading="lazy"
    />
  </div>
  <div class="body">
    <h3>{product.name}</h3>
    <p class="price">
      <span class="from">From</span>{' '}{product.priceFrom}
    </p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--purple);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 7%);
  }

  /* Printful mockups are square with a near-white backdrop; the tint keeps the
     product from dissolving into the card on light themes. */
  .shot {
    aspect-ratio: 1;
    background: var(--paper-alt);
    display: grid;
    place-items: center;
    padding: 0.5rem;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.25rem;
  }

  h3 {
    font-size: 1rem;
    line-height: 1.35;
    margin: 0;
  }

  .card:hover h3 {
    color: var(--purple);
  }

  .price {
    margin: auto 0 0;
    font-weight: 700;
    color: var(--ink);
  }

  .from {
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
</style>
